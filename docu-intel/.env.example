# =============================================================================
# DOCU-INTEL CONFIGURATION
# =============================================================================
# IMPORTANT: Change ALL secrets before deploying to any network!
# Generate secure secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# Environment: local, development, staging, production
ENVIRONMENT=local

# Database Configuration
# Change the password before deployment!
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_SECURE_PASSWORD@postgres:5432/docuintel
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# File Storage
FILES_DIR=/app/data/files
INPUT_DIR=/app/data/input
SCAN_INTERVAL_SECONDS=300
INGESTION_STABLE_SECONDS=30
INGESTION_MAX_PENDING_JOBS=200
FILE_STORAGE_STRATEGY=auto
ALLOWED_FILE_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tif",".tiff",".bmp",".webp",".xls",".xlsx",".xlsm",".csv",".tsv",".txt",".log",".eml"]
MAX_UPLOAD_SIZE_MB=200
MAX_PDF_PAGES=500
MAX_IMAGE_MEGAPIXELS=80
MAX_EXCEL_ROWS=100000
MAX_EXCEL_SHEETS=50
PDF_OCR_DPI=144
VECTOR_STORE=pgvector

# Watcher Configuration (optimized for Docker/Windows)
WATCHER_ENABLED=true
WATCHER_BACKEND=polling
WATCHER_RECURSIVE=true
WATCHER_POLL_SECONDS=5
WATCHER_SETTLE_SECONDS=10
WATCHER_RESCAN_INTERVAL_SECONDS=3600
WATCHER_MAX_FILES_PER_TICK=10

# CORS Configuration
# In production, specify only your domains (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# AI Configuration (Local LLM)
AI_PROVIDER=local_openai_compatible
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_MODEL=qwen2.5-32b-instruct
AI_API_KEY=

# OCR Configuration
OCR_ENGINE=paddleocr
ENABLE_DOTS_MOCR=false

# Embeddings Configuration
EMBEDDING_PROVIDER=local_openai_compatible
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_TO_HASH=true

# Integration API Configuration
# Optional seed format: client-name:api-key:read,upload;other-client:other-key:read
INTEGRATION_CLIENTS=
INTEGRATION_ENQUEUE_UPLOADS=true
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
INTEGRATION_SESSION_EXPIRE_SECONDS=3600
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_EVENTS=["document.processed","document.failed","document.needs_review","job.finished","docuintel.webhook_test"]

# GlitchTip / Sentry-compatible error tracking.
# Leave SENTRY_DSN empty to disable. GlitchTip accepts a Sentry-compatible DSN.
# Example local: http://<key>@glitchtip:8000/<project_id>
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_SEND_PII=false

# Frontend flags
VITE_ENABLE_TENANT_ADMIN=false

# =============================================================================
# SECURITY - CHANGE THESE BEFORE DEPLOYMENT!
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_TOKEN_MIN_64_CHARS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=10/minute

# Admin Credentials (must be at least 16 characters)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS_SECURE_PASSWORD
ADMIN_NAME=Administrador
# =============================================================================
