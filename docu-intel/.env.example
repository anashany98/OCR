# =============================================================================
# DOCU-INTEL CONFIGURATION
# =============================================================================
# IMPORTANT: Change ALL secrets before deploying to any network!
# Generate secure secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# Environment: local, development, staging, production
ENVIRONMENT=local

# Database Configuration
# Change the password before deployment!
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_SECURE_PASSWORD@postgres:5432/docuintel
REDIS_URL=redis://redis:6379/0
# Use Redis for rate limiting (memory:// loses state on restart)
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# File Storage
FILES_DIR=/app/data/files
INPUT_DIR=/app/data/input
SCAN_INTERVAL_SECONDS=300
INGESTION_STABLE_SECONDS=30
INGESTION_MAX_PENDING_JOBS=200
FILE_STORAGE_STRATEGY=auto
ALLOWED_FILE_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tif",".tiff",".bmp",".webp",".xls",".xlsx",".xlsm",".csv",".tsv",".txt",".log",".eml"]
MAX_UPLOAD_SIZE_MB=200
MAX_PDF_PAGES=500
MAX_IMAGE_MEGAPIXELS=80
MAX_EXCEL_ROWS=100000
MAX_EXCEL_SHEETS=50
PDF_OCR_DPI=144
VECTOR_STORE=pgvector

# Watcher Configuration (optimized for Docker/Windows)
WATCHER_ENABLED=true
WATCHER_BACKEND=polling
WATCHER_RECURSIVE=true
WATCHER_POLL_SECONDS=5
WATCHER_SETTLE_SECONDS=10
WATCHER_RESCAN_INTERVAL_SECONDS=3600
WATCHER_MAX_FILES_PER_TICK=10

# CORS Configuration
# In production, specify only your domains (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# AI Configuration (Local LLM)
AI_PROVIDER=local_openai_compatible
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_MODEL=qwen2.5-32b-instruct
AI_API_KEY=

# OCR Configuration
# OCR engine: tesseract | paddleocr | cascading | pp_structure
OCR_ENGINE=cascading
ENABLE_DOTS_MOCR=false
# Tesseract 5 settings (Tier 1 / standalone)
TESSERACT_LANG=spa+eng
TESSERACT_OEM=1
TESSERACT_PSM=3
# PaddleOCR language (Tier 2)
PADDLE_LANG=es

# ---------------------------------------------------------------------------
# UPG-5 — PaddleOCR 3.7 / PP-OCRv6 profile selection
# ---------------------------------------------------------------------------
# PaddleOCR profile id (resolved via app.ocr.model_registry).
# Valid ids: ppocr_v5_server | ppocr_v6_tiny | ppocr_v6_small |
#            ppocr_v6_medium (default) | custom
PADDLE_OCR_PROFILE=ppocr_v6_medium
# Custom model overrides (only used by the ``custom`` profile or to point
# the adapter at a private model directory). Leave empty to use the
# profile's bundled models.
PADDLE_TEXT_DETECTION_MODEL_NAME=
PADDLE_TEXT_RECOGNITION_MODEL_NAME=
# Prefer PaddleOCR 3.x ``predict()`` over the legacy ``ocr()`` API.
PADDLE_USE_PREDICT_API=true
# Escape hatches: force one API path explicitly (settings win over the
# profile default).
PADDLE_FORCE_LEGACY_OCR_API=false
PADDLE_FORCE_PREDICT_API=false
# Whether the adapter should auto-detect the PaddleOCR version and the
# APIs it exposes. Recommended on. Disable only when running against
# a frozen PaddleOCR build where auto-detection mis-fires.
PADDLE_ENABLE_MODEL_AUTODETECT=true
# Whether to silently swallow unknown PaddleOCR output shapes and
# return an empty result, instead of raising. Recommended on for
# production; tests flip it off to assert version-drift compatibility.
PADDLE_ALLOW_UNKNOWN_OUTPUT_FORMAT=true
# Emit a one-shot INFO log when the underlying PaddleOCR engine is
# initialised, with version + profile + device info.
PADDLE_LOG_RUNTIME_INFO=true

# ---------------------------------------------------------------------------
# UPG-5 — PP-Structure / PaddleX 3.7.1 / PP-StructureV3 profile
# ---------------------------------------------------------------------------
# Tier 3 master switch (the cascade only fires PP-Structure when this
# is true AND Tier 1 + Tier 2 are both weak).
OCR_CASCADING_USE_PP_STRUCTURE=false
# PP-Structure profile id (resolved via app.ocr.model_registry).
# Valid ids: pp_structure_v3 (default) | layout_parsing_legacy | custom
PP_STRUCTURE_PROFILE=pp_structure_v3
# Optional pipeline name override; only honoured by the ``custom``
# profile. Leave empty for the standard ``layout_parsing`` pipeline.
PP_STRUCTURE_PIPELINE_NAME=
# Try ``PPStructureV3`` first; fall back to
# ``paddlex.create_pipeline('layout_parsing')`` automatically when
# PPStructureV3 is unavailable.
PP_STRUCTURE_USE_V3=true
# Append the layout_parsing markdown export (when the version exposes
# one) to the OCRResult.text.
PP_STRUCTURE_EXPORT_MARKDOWN=true
# Persist the raw structured JSON on the OCRResult metadata.
PP_STRUCTURE_EXPORT_JSON=true
# Force the paddlex.create_pipeline('layout_parsing') path, bypassing
# PPStructureV3 entirely. Useful as a rollback when the V3 path is
# unstable on a given PaddleX build.
PP_STRUCTURE_FORCE_PADDLEX_FALLBACK=false
# Emit a one-shot INFO log when the underlying PaddleX pipeline is
# initialised, with version + profile + device info.
PP_STRUCTURE_LOG_RUNTIME_INFO=true

# Embeddings Configuration
EMBEDDING_PROVIDER=local_openai_compatible
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_TO_HASH=true

# Max number of file parts in a single multipart upload (python-multipart's
# default is 1000). Raise this if you need to upload folders with very many
# files. Pair it with a generous client_max_body_size in frontend/nginx.conf.
MAX_UPLOAD_FILES=10000000

# Integration API Configuration
# Optional seed format: client-name:api-key:read,upload;other-client:other-key:read
INTEGRATION_CLIENTS=
INTEGRATION_ENQUEUE_UPLOADS=true
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
INTEGRATION_SESSION_EXPIRE_SECONDS=3600
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_EVENTS=["document.processed","document.failed","document.needs_review","job.finished","docuintel.webhook_test"]

# GlitchTip / Sentry-compatible error tracking.
# Leave SENTRY_DSN empty to disable. GlitchTip accepts a Sentry-compatible DSN.
# Example local: http://<key>@glitchtip:8000/<project_id>
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_SEND_PII=false

# Frontend flags
VITE_ENABLE_TENANT_ADMIN=false

# =============================================================================
# SECURITY - CHANGE THESE BEFORE DEPLOYMENT!
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_TOKEN_MIN_64_CHARS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=10/minute

# Admin Credentials (must be at least 16 characters)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS_SECURE_PASSWORD
ADMIN_NAME=Administrador
# =============================================================================
