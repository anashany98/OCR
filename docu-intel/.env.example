# =============================================================================
# DOCU-INTEL CONFIGURATION
# =============================================================================
# IMPORTANT: Change ALL secrets before deploying to any network!
# Generate secure secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# Environment: local, development, staging, production
ENVIRONMENT=local

# Database Configuration
# Change the password before deployment!
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_SECURE_PASSWORD@postgres:5432/docuintel
REDIS_URL=redis://redis:6379/0
# Use Redis for rate limiting (memory:// loses state on restart)
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# File Storage
FILES_DIR=/app/data/files
INPUT_DIR=/app/data/input
# Read-only mount of the original document corpus (e.g. D:/TEST2025/2025).
# The watcher container mounts this at /app/source/2025:ro.
SOURCE_CORPUS_DIR=D:/TEST2025/2025
SCAN_INTERVAL_SECONDS=300
INGESTION_STABLE_SECONDS=30
INGESTION_MAX_PENDING_JOBS=200
FILE_STORAGE_STRATEGY=auto
ALLOWED_FILE_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tif",".tiff",".bmp",".webp",".xls",".xlsx",".xlsm",".csv",".tsv",".txt",".log",".eml"]
MAX_UPLOAD_SIZE_MB=200
MAX_PDF_PAGES=500
MAX_IMAGE_MEGAPIXELS=80
MAX_EXCEL_ROWS=100000
MAX_EXCEL_SHEETS=50
PDF_OCR_DPI=144
VECTOR_STORE=pgvector

# Watcher Configuration (optimized for Docker/Windows)
WATCHER_ENABLED=true
WATCHER_BACKEND=polling
WATCHER_RECURSIVE=true
WATCHER_POLL_SECONDS=5
WATCHER_SETTLE_SECONDS=10
WATCHER_RESCAN_INTERVAL_SECONDS=3600
WATCHER_MAX_FILES_PER_TICK=10

# CORS Configuration
# In production, specify only your domains (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# AI Configuration (Local LLM)
AI_PROVIDER=local_openai_compatible
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_MODEL=qwen2.5-32b-instruct
AI_API_KEY=

# OCR Configuration
OCR_ENGINE=paddleocr
ENABLE_DOTS_MOCR=false

# NuExtract3 visual OCR / structured extraction (optional, served by vLLM)
NUEXTRACT_ENABLED=false
NUEXTRACT_BASE_URL=http://nuextract-vllm:8000/v1
NUEXTRACT_MODEL=numind/NuExtract3
NUEXTRACT_TIMEOUT_SECONDS=120
NUEXTRACT_ENABLE_THINKING=false
NUEXTRACT_MAX_CONCURRENCY=1
NUEXTRACT_MAX_IMAGES=4
NUEXTRACT_MARKDOWN_TEMPERATURE=0.2
NUEXTRACT_EXTRACTION_TEMPERATURE=0.2
NUEXTRACT_TIER4_ENABLED=false
NUEXTRACT_HYPEREXTRACT_ENABLED=false

# Embeddings Configuration
EMBEDDING_PROVIDER=local_openai_compatible
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# F2-01: pinned to Granite multilingual R2 (768d, cosine)
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_TO_HASH=false

# Document-level embedding (FASE 8.1). Populates Document.embedding with a
# single embedding of the whole document text (truncated to fit the model's
# context window) and fuses its retrieval signal with per-chunk search via RRF.
# Alternative to canonical late chunking (which needs a TEI server for token
# embeddings). Set to false to use chunk-only retrieval.
SEARCH_USE_DOCUMENT_EMBEDDING=true
DOCUMENT_EMBEDDING_MAX_TOKENS=6000

# Max number of file parts in a single multipart upload (python-multipart's
# default is 1000). Capped to 2000 to keep the per-request memory bounded;
# raise this only if you really need to upload folders with thousands of
# files. Pair it with a generous client_max_body_size in frontend/nginx.conf.
MAX_UPLOAD_FILES=2000

# Integration API Configuration
# Optional seed format: client-name:api-key:read,upload;other-client:other-key:read
INTEGRATION_CLIENTS=
INTEGRATION_ENQUEUE_UPLOADS=true
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
INTEGRATION_SESSION_EXPIRE_SECONDS=3600
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_EVENTS=["document.processed","document.failed","document.needs_review","job.finished","docuintel.webhook_test"]

# GlitchTip / Sentry-compatible error tracking.
# Leave SENTRY_DSN empty to disable. GlitchTip accepts a Sentry-compatible DSN.
# Example local: http://<key>@glitchtip:8000/<project_id>
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_SEND_PII=false

# Frontend flags
VITE_ENABLE_TENANT_ADMIN=false

# =============================================================================
# Hyper-Extract (optional structured-extraction layer on top of OCR)
# =============================================================================
# When HYPEREXTRACT_ENABLED=false the module is fully bypassed: no provider
# call, no DB write, no extra latency. Set to true only after configuring
# the OpenAI-compatible endpoint that will serve the extraction model.
# The integration is decoupled from OCR — OCR keeps running even if this
# layer fails — and never touches the public OCR response shape.
HYPEREXTRACT_ENABLED=false
# Provider is OpenAI-compatible (LM Studio, vLLM, Ollama with /v1,
# OpenAI, or any MiniMax M3-style OpenAI-compatible gateway).
HYPEREXTRACT_PROVIDER=openai_compatible
HYPEREXTRACT_BASE_URL=
HYPEREXTRACT_MODEL=
HYPEREXTRACT_API_KEY=
HYPEREXTRACT_TIMEOUT_SECONDS=120
HYPEREXTRACT_MAX_RETRIES=1
HYPEREXTRACT_OUTPUT_DIR=./storage/hyperextract
HYPEREXTRACT_DEFAULT_TYPE=factura
HYPEREXTRACT_PERSIST_RAW_OUTPUT=true
# When true, Hyper-Extract runs automatically inside the OCR pipeline.
# When false (default), only explicit API calls or the test script trigger it.
HYPEREXTRACT_RUN_IN_PIPELINE=false

# Optional: MiniMax M3 as the Hyper-Extract provider (OpenAI-compatible).
# Leave HYPEREXTRACT_BASE_URL/MODEL/API_KEY empty if you do not want this.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Reverse proxy trust list for uvicorn --proxy-headers. Limits the IPs from
# which the backend will honour X-Forwarded-For (otherwise rate limiting and
# audit IP can be spoofed). In local dev the only proxy is the loopback
# nginx; in production set this to the CIDR of your real reverse proxy
# (e.g. 10.0.0.0/8). Refusing "*" in production is enforced by the backend.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# =============================================================================
# SECURITY - CHANGE THESE BEFORE DEPLOYMENT!
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_TOKEN_MIN_64_CHARS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=10/minute

# Admin Credentials (must be at least 16 characters)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS_SECURE_PASSWORD
ADMIN_NAME=Administrador
# =============================================================================
