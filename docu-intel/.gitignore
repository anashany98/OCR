.env
.env.local
.env.production
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
.vite/
data/files/*
!data/files/.gitkeep
data/input/**/*
!data/input/**/.gitkeep
postgres_data/
.kilo/
.kiro/
# Local LM Studio shim logs (host-side process)
lms_server.log
lms_server.log.err
# TypeScript incremental build cache
*.tsbuildinfo
# Generated golden fixture PNGs (created at runtime by test fixture builder)
backend/tests/fixtures/golden/
# MiniMax M3 performance data (local benchmark outputs, may contain timing only)
data/minimax-m3-performance/
# MiniMax M3 corpus snapshots (local-only, never commit raw document dumps)
data/minimax-m3-corpus-snapshot.txt

# OvisOCR2 benchmark/certification outputs may contain document-derived metadata.
artifacts/ovisocr2/*
!artifacts/ovisocr2/README.md

# Graphify's per-file AST cache is a local rebuild artifact.
graphify-out/cache/ast/

# Local PostgreSQL backups can contain documents, chats, contacts and users.
# Keep migration safety copies on the host; never publish them to Git.
data/backups/*.dump

