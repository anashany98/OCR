FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_ENABLE_TENANT_ADMIN=false
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
ARG VITE_SENTRY_PROFILES_SAMPLE_RATE=0.0
ARG VITE_SENTRY_ENVIRONMENT=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ENABLE_TENANT_ADMIN=$VITE_ENABLE_TENANT_ADMIN
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_SENTRY_PROFILES_SAMPLE_RATE=$VITE_SENTRY_PROFILES_SAMPLE_RATE
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
