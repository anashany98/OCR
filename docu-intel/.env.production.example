# Docu-Intel production environment example.
# Copy to .env.production or inject these variables from your secret manager.

ENVIRONMENT=production

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/docuintel
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0
RATE_LIMIT_STORAGE_URI=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0

# SEC-RL-1 (Sprint 0): CIDR of the reverse proxy that fronts the backend.
# uvicorn only honours X-Forwarded-For when the immediate peer matches
# this allow-list. Use a single IP or a CIDR; never leave it at "*" in
# production (an attacker on the same network as the proxy can spoof
# X-Forwarded-For and bypass the rate limit).
#
# Examples:
#   UVICORN_FORWARDED_ALLOW_IPS=10.0.0.5           (single proxy)
#   UVICORN_FORWARDED_ALLOW_IPS=10.0.0.0/8         (private network)
UVICORN_FORWARDED_ALLOW_IPS=10.0.0.0/8

FILES_DIR=/app/data/files
INPUT_DIR=/app/data/input
SCAN_INTERVAL_SECONDS=300
INGESTION_STABLE_SECONDS=60
INGESTION_MAX_PENDING_JOBS=500
FILE_STORAGE_STRATEGY=copy
ALLOWED_FILE_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tif",".tiff",".bmp",".webp",".xls",".xlsx",".xlsm",".csv",".tsv",".txt",".log",".eml"]
MAX_UPLOAD_SIZE_MB=200
MAX_PDF_PAGES=500
MAX_IMAGE_MEGAPIXELS=80
MAX_EXCEL_ROWS=100000
MAX_EXCEL_SHEETS=50
PDF_OCR_DPI=144
VECTOR_STORE=pgvector

WATCHER_ENABLED=true
WATCHER_BACKEND=polling
WATCHER_RECURSIVE=true
WATCHER_POLL_SECONDS=10
WATCHER_SETTLE_SECONDS=30
WATCHER_RESCAN_INTERVAL_SECONDS=1800
WATCHER_MAX_FILES_PER_TICK=20

CORS_ORIGINS=["https://docuintel.example.local"]

AI_PROVIDER=local_openai_compatible
# CAMBIA ESTO: la IP de la LAN donde corre el LLM (NO uses host.docker.internal en producción,
# no resuelve fuera de Docker Desktop en Windows). Si levantas el LLM dentro del compose, usa
# el nombre del servicio (p. ej. http://llama-server:8080/v1).
AI_BASE_URL=http://REPLACE_WITH_LAN_IP_OF_LLM_HOST:1234/v1
AI_MODEL=qwen2.5-32b-instruct
AI_API_KEY=

OCR_ENGINE=paddleocr
ENABLE_DOTS_MOCR=false

EMBEDDING_PROVIDER=local_openai_compatible
EMBEDDING_BASE_URL=http://REPLACE_WITH_LAN_IP_OF_LLM_HOST:1234/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_TO_HASH=false

INTEGRATION_CLIENTS=
INTEGRATION_ENQUEUE_UPLOADS=true
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
INTEGRATION_SESSION_EXPIRE_SECONDS=3600
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_EVENTS=["document.processed","document.failed","document.needs_review","job.finished","docuintel.webhook_test"]

JWT_SECRET=GENERATE_A_SECURE_RANDOM_TOKEN_OF_AT_LEAST_64_CHARACTERS_FOR_PRODUCTION_USE
# SEC-TENANT-1 (Sprint 1): deny-by-default multi-tenant isolation.
# When True (the new default), a user with no AccessGroup membership
# sees zero documents. Access is granted explicitly via AccessGroup
# assignment. The migration 0028_tenant_default_permissive_group
# backfills a "default-permissive" group for every existing non-admin
# user so deployments upgrading from a pre-Sprint-1 install do not
# lose access unexpectedly. Set to False only if you are migrating
# from pre-Sprint-1 AND have NOT run the backfill migration.
TENANT_ACCESS_DENY_BY_DEFAULT=true

# AUTH-JWT-1 (Sprint 1): per-purpose secrets. A leak in one purpose
# (e.g. the integration API key) MUST NOT compromise another
# (e.g. a user access token). Generate each with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left empty, the corresponding use-site falls back to
# JWT_SECRET (legacy single-secret mode). Production deployments
# MUST set distinct values.
INTEGRATION_JWT_SECRET=GENERATE_A_DIFFERENT_64_CHAR_RANDOM_TOKEN_FOR_INTEGRATION_JWT
API_KEY_HMAC_SECRET=GENERATE_A_DIFFERENT_64_CHAR_RANDOM_TOKEN_FOR_API_KEY_HASHING
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_LOGIN_RATE_LIMIT=10/minute
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=GENERATE_A_SECURE_ADMIN_PASSWORD_OF_AT_LEAST_16_CHARACTERS
ADMIN_NAME=Administrador

WORKER_FAST_CONCURRENCY=2
WORKER_MAINTENANCE_CONCURRENCY=1
OCR_WORKER_CONCURRENCY=1
APP_UID=10001
APP_GID=10001
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_TENANT_ADMIN=false

# H-6: GlitchTip (opt-in via --profile monitoring) refuses to start
# without strong, unique secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GLITCHTIP_SECRET_KEY=GENERATE_A_DIFFERENT_48_CHAR_RANDOM_TOKEN_FOR_GLITCHTIP_SECRET
GLITCHTIP_DB_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_DB_PASSWORD_FOR_GLITCHTIP
