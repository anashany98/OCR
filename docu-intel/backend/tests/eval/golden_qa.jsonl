# S0.4 — Golden Q&A set for RAG evaluation.
#
# This is the STARTER set shipped with the codebase. It is intentionally
# small and uses placeholder ``expected_document_ids`` so the evaluation
# harness has something to score against in CI before the team curates
# the real ground truth.
#
# Format: JSONL, one question per line. Lines starting with ``#`` and
# blank lines are ignored. Fields:
#
#   id:                     stable identifier (e.g. "q001").
#   category:               one of "presupuesto", "pedido", "factura",
#                           "plano", "exploratory". Used to break down
#                           metrics in the report.
#   question:               the exact text the user would type.
#   expected_document_ids:  document ids the top-k retrieval should
#                           surface. Use [] for exploratory questions.
#   expected_keywords:      literal substrings the answer is expected
#                           to mention (importes, NIFs, dates, room
#                           names, etc.). Used to score
#                           answer_relevancy without an LLM.
#   min_context_recall:     per-question gate. The report flags the
#                           question as failing when the actual recall
#                           is below this threshold. Defaults to 0.5
#                           in the evaluator when omitted.
#
# To curate the real set, replace the placeholder
# ``expected_document_ids`` with the ids returned by
# ``GET /documents?limit=1&filename=<the file>`` after the relevant
# documents are indexed. Add at least 30 questions spanning the five
# categories so the aggregate metrics are statistically meaningful.

# ---- Presupuestos ----
{"id": "q001", "category": "presupuesto", "question": "Cual es el importe total del presupuesto 245745?", "expected_document_ids": [], "expected_keywords": ["245745", "EUR"], "min_context_recall": 0.5}
{"id": "q002", "category": "presupuesto", "question": "Que cliente aparece en el presupuesto aceptado de la ultima semana?", "expected_document_ids": [], "expected_keywords": ["cliente", "presupuesto"], "min_context_recall": 0.5}
{"id": "q003", "category": "presupuesto", "question": "Listame los presupuestos aceptados que aun no tienen pedido asociado.", "expected_document_ids": [], "expected_keywords": ["presupuesto", "aceptado", "pedido"], "min_context_recall": 0.5}
{"id": "q004", "category": "presupuesto", "question": "Cual es el presupuesto con mayor importe del proyecto?", "expected_document_ids": [], "expected_keywords": ["presupuesto", "importe"], "min_context_recall": 0.5}

