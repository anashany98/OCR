# GPU variant of the backend image. PaddlePaddle 3.3.0 ships GPU support
# in the unified `paddlepaddle` wheel, so all this image has to do is
# provide a CUDA runtime + cuDNN on top of Python 3.11.
#
# The CPU image (../Dockerfile) stays on python:3.11-slim. The two images
# are interchangeable at the code level — only the OCR worker performance
# differs.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Python 3.11 from the deadsnakes PPA (Ubuntu 22.04 ships 3.10) plus the
# same apt deps the CPU image has, plus the NVIDIA repo keys that some
# nvidia/cuda images need refreshed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    build-essential \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    poppler-utils \
    libreoffice-core \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Force python3.11 to be the default `python` and bootstrap pip (the
# python3.11-distutils above provides the stdlib `distutils` that
# bootstrap-pip still relies on).
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && python -m ensurepip --upgrade \
    && python -m pip install --upgrade pip

# Same appuser as the CPU image so file ownership matches the bind-mount
# expectations on the host.
RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home /app appuser \
    && mkdir -p /app/data/files /app/data/input \
    && chown -R appuser:appuser /app

COPY requirements.txt /app/requirements.txt
# paddlepaddle-gpu is published only on PaddlePaddle's own index; PyPI
# only carries the CPU build. We pin to cu126 to match the CUDA 12.6
# runtime in the nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04 base.
RUN python -m pip install --default-timeout=120 --retries=5 \
    -i https://www.paddlepaddle.org.cn/packages/stable/cu126/ \
    --extra-index-url https://pypi.org/simple \
    paddlepaddle-gpu==3.3.0 \
    && python -m pip install --default-timeout=120 --retries=5 -r /app/requirements.txt

COPY app /app/app
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
COPY scripts /app/scripts

# Default CMD is the celery worker. The compose file overrides this per
# service (e.g. the GPU workers pass `-Q ocr_heavy -n worker-heavy-gpu-N@%h`).
CMD ["celery", "-A", "app.workers.celery_app.celery_app", "worker", "--loglevel=INFO"]
